# HyperSight server configuration. Copy to .env and fill in. Never commit .env.
# Testnet only: the server refuses to start with any non-testnet Hyperliquid URL.

# Hyperliquid master account (queried for all state) and its API/agent wallet key (signs orders; cannot withdraw)
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
# Optional: PAIRING=1 pairs the glasses with a code instead (open /link, approve a trade-only agent
# with your wallet). HL_AGENT_PRIVATE_KEY is then not used; HL_ACCOUNT_ADDRESS, if set, is the only
# account allowed to pair. Build the page first: pnpm --filter @hypersight/link build
PAIRING=
# Optional: where the built link page lives (default apps/link/dist)
LINK_DIST=

# Intent parsing fallback (Claude) and speech-to-text (ElevenLabs Scribe v2 Realtime)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional, defaults to claude-opus-5-5
INTENT_MODEL=
# Optional: en (default) or multi (speech-to-text detects the language; Spanish commands work too)
VOICE_LANG=

# 32-byte hex key used to seal paired agent keys at rest (openssl rand -hex 32)
ENCRYPTION_KEY=
# Bearer token shared by the HUD and the companion API (single user)
SESSION_TOKEN=

# Optional: read-only Gram (TON testnet) wallet card
TON_ADDRESS=

# testnet | paper | fake (default testnet)
EXECUTOR=
# HTTP/WS port (default 8787)
PORT=
# SQLite file (default ./data/hypersight.sqlite)
DB_PATH=
